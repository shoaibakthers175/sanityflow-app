{
  "name": "sanityflow-desktop",
  "version": "1.0.0",
  "description": "SanityFlow - Desktop QA Sanity Checklist Manager",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"node server.js\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "start:web": "node server.js",
    "start:electron": "electron .",
    "serve": "node server.js",
    "app:dev": "concurrently -k \"node server.js\" \"vite\" \"wait-on tcp:5173 && electron .\""
  },
  "keywords": [
    "qa",
    "sanity-testing",
    "checklist",
    "electron",
    "react",
    "sqlite"
  ],
  "author": "SanityFlow Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-router-dom": "^6.29.0",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
